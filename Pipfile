[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# YouTube transcript/video fetching
yt-dlp = "*"

# Claude API - used by Analyst/Director/Engineer agents
anthropic = ">=0.40.0"

# Supabase vector store (optional: falls back to vector_cache.json)
