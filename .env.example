# Performance: LOW (Chromebook) or HIGH (Desktop/CI)
PERFORMANCE_MODE=LOW

# Claude API — required for expression enrichment (Step 2.5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Rendering
REMOTION_CPU_CORES=1

# Source (single video only; playlist params like &list=...&index=N are ignored)
YT_VIDEO_URL=https://www.youtube.com/watch?v=XXXXX
